<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui">
    <layout expand="chat">
        <aichat:aiChat id="chat" width="100%" height="100%">
            <aichat:emptyStateHeader>
                <h3 text="msg://emptyStateHeader.text"/>
            </aichat:emptyStateHeader>
            <aichat:emptyStateFooter>
                <hbox padding="false" wrap="true" justifyContent="CENTER">
                    <button id="codeButton" text="msg://codeButton.text" themeNames="tertiary"/>
                    <button id="longTextButton" text="msg://longTextButton.text" themeNames="tertiary"/>
                    <button id="errorButton" text="msg://errorButton.text" themeNames="tertiary"/>
                </hbox>
            </aichat:emptyStateFooter>
        </aichat:aiChat>
    </layout>
</view>
